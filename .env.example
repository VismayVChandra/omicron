# Copy this file to .env (for `vercel dev`) or set it in the Vercel dashboard
# under Project Settings → Environment Variables.

# Required. The model that writes the decks. Free, no card.
# https://console.groq.com/keys
GROQ_API_KEY=

# Optional — generated slide images. Set ONE of the three groups below; the
# first one configured is the one used. Without any of them the Generate button
# stays hidden and slide photographs come from Wikimedia Commons as before.

# Cloudflare Workers AI — the free one. 10,000 neurons a day, and FLUX-1-schnell
# costs 4.8 per tile, so roughly 200 images a day without a card.
# Both from one place: dash.cloudflare.com → Workers AI → "Use REST API", which
# shows the account id and creates the token. The "Workers AI" token template
# grants Workers AI Read AND Edit — the REST API needs both, so keep both rows,
# and set Account Resources to your account or the token will not work.
#
# CF_API_TOKEN must start cfut_ — a scoped User API Token. The other credential
# on that dashboard starts cfk_ and is the Global API Key: it has full access to
# the entire account, uses a different auth scheme, and belongs nowhere near a
# deployed web app. Sent here it fails with a bare "Authentication error".
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Together AI — FLUX.1-schnell has a free endpoint, though it has been promo-
# tional in the past, so check it is still free before relying on it.
# https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=

# Google Gemini image (Nano Banana). The best pictures of the three and the
# only one that is not free: Google's pricing page lists Free Tier as "not
# available" for every one of its image models. Needs billing enabled.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — accounts, so saved decks follow you between devices.
# See the "Accounts" section of README.md.
SUPABASE_URL=
SUPABASE_ANON_KEY=
